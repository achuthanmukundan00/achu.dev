---
import { projectStatus, type Project } from "@data/projects";

export interface Props {
  project: Project;
  showStatus?: boolean;
}

const { project, showStatus = true } = Astro.props;
const status = projectStatus(project);
---

<li>
  <a class="row" href={`/work/${project.slug}`}>
    <span class="row-main">
      <span class="row-title">{project.title}</span>
      <span class="row-desc">{project.tagline}</span>
    </span>
    {showStatus && <span class="row-side">{status}</span>}
  </a>
</li>
