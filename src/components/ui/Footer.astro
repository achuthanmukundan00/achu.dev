---
import { links } from "@data/links";
import { site } from "@data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-shell footer-inner">
    <span>&copy; {year} {site.fullName}. Toronto, Canada.</span>
    <div class="footer-links">
      <a href={`mailto:${links.email}`}>Email</a>
      <a href={links.github} target="_blank" rel="noopener noreferrer me">GitHub</a>
      <a href={links.linkedin} target="_blank" rel="noopener noreferrer me">LinkedIn</a>
    </div>
  </div>
</footer>
