---
import "@/styles/global.css";
import Nav from "@components/ui/Nav.astro";
import Footer from "@components/ui/Footer.astro";
import { links } from "@data/links";
import { site } from "@data/site";

export interface Props {
  title: string;
  description?: string;
  fullWidth?: boolean;
  canonical?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description = site.supportingLine,
  canonical,
  ogType = "website",
  publishedTime,
  modifiedTime,
  noindex = false,
  ogImage = site.ogImage,
  ogImageAlt = "Achu Mukundan, software engineer",
} = Astro.props;

const pageTitle = title === "Home" ? site.name : `${title} | ${site.fullName}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site.url).toString();
const ogImageUrl = new URL(ogImage, site.url).toString();

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.fullName,
  url: site.url,
  jobTitle: "Software Engineer",
  homeLocation: {
    "@type": "Place",
    name: site.location,
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "University of Toronto",
  },
  sameAs: [links.github, links.linkedin],
  knowsAbout: [
    "Software engineering",
    "Developer tools",
    "AI agents",
    "Local inference",
    "Audio software",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f0f0e" />
    <meta name="color-scheme" content="dark" />
    <meta name="author" content={site.fullName} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="preload" href="/fonts/local/LocalGrotesk-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/local/LocalGrotesk.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Achu Mukundan" href="/rss.xml" />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
  </head>
  <body>
    <!--email_off-->
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Hand-set headings: each letter gets a fixed weight, tilt and stretch.
      // Only the tape strips animate.
      (() => {
        const rand = (a, b) => a + Math.random() * (b - a);
        const fix = (n, u = "") => n.toFixed(3) + u;
        const headings = document.querySelectorAll(
          ".brand, .page-head h1, .empty-state h1, .case-head h1, .article-header h1, .article-prose h2, .article-prose h3"
        );
        for (const el of headings) {
          if (el.dataset.boil) continue;
          el.dataset.boil = "";
          if (!el.children.length && !el.hasAttribute("aria-label")) {
            el.setAttribute("aria-label", el.textContent.trim());
          }
          const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
          const nodes = [];
          while (walker.nextNode()) nodes.push(walker.currentNode);
          for (const node of nodes) {
            const frag = document.createDocumentFragment();
            for (const part of node.textContent.split(/(\s+)/)) {
              if (!part) continue;
              if (/^\s+$/.test(part)) {
                frag.append(part);
                continue;
              }
              const word = document.createElement("span");
              word.className = "boil-word";
              word.setAttribute("aria-hidden", "true");
              for (const ch of part) {
                const l = document.createElement("span");
                l.className = "boil-letter";
                l.textContent = ch;
                l.style.setProperty("--w", Math.round(rand(530, 680)));
                l.style.setProperty("--r0", fix(rand(-2.2, 2.2), "deg"));
                l.style.setProperty("--y0", fix(rand(-0.035, 0.035), "em"));
                l.style.setProperty("--s0", fix(rand(0.94, 1.07)));
                word.append(l);
              }
              frag.append(word);
            }
            node.replaceWith(frag);
          }
        }
        for (const tape of document.querySelectorAll(".tape, .section-head h2")) {
          tape.style.setProperty("--d", fix(-rand(0, 0.6), "s"));
          tape.style.setProperty("--t0", fix(rand(-2.2, -0.6), "deg"));
          tape.style.setProperty("--t1", fix(rand(-2.2, -0.6), "deg"));
          tape.style.setProperty("--t2", fix(rand(-2.2, -0.6), "deg"));
        }
      })();
    </script>
    <!--/email_off-->
  </body>
</html>
