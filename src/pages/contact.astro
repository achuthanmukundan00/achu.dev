---
import BaseLayout from "@layouts/BaseLayout.astro";
import { links } from "@data/links";
import { seo } from "@data/site";
---

<BaseLayout title="Contact" description={seo.contact.description}>
  <div class="shell">
    <header class="page-head">
      <h1>Contact</h1>
    </header>

    <div class="contact-list">
      <a class="contact-item" href={`mailto:${links.email}`}>
        <span class="label">Email</span>
        <span class="value">{links.email}</span>
      </a>
      <a class="contact-item" href={links.github} target="_blank" rel="noopener noreferrer me">
        <span class="label">GitHub</span>
        <span class="value">achuthanmukundan00</span>
      </a>
      <a class="contact-item" href={links.linkedin} target="_blank" rel="noopener noreferrer me">
        <span class="label">LinkedIn</span>
        <span class="value">Achu Mukundan</span>
      </a>
    </div>
  </div>
</BaseLayout>
