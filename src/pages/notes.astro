---
import BaseLayout from "@layouts/BaseLayout.astro";
import NoteRow from "@components/note/NoteRow.astro";
import { notes } from "@data/notes";
import { seo } from "@data/site";
---

<BaseLayout title="Writing" description={seo.notes.description}>
  <div class="shell">
    <header class="page-head">
      <h1>Writing</h1>
    </header>

    <ul class="posts" aria-label="Published notes">
      {notes.map((note) => <NoteRow note={note} />)}
    </ul>
  </div>
</BaseLayout>
