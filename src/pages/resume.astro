---
import BaseLayout from "@layouts/BaseLayout.astro";
import { links } from "@data/links";
import { seo } from "@data/site";
---

<BaseLayout title="Resume" description={seo.resume.description}>
  <div class="site-shell">
    <header class="page-header">
      <h1>Resume</h1>
      <p class="lead">
        Software engineer working on developer tools, AI systems, and audio software.
      </p>
      <p class="body-copy">
        I have experience with conversational AI in production and currently build an
        open-source coding agent in Rust. I'm looking for early-career software engineering
        roles where I can contribute across the stack and keep learning.
      </p>
      <div class="link-row">
        <a class="action" href={`mailto:${links.email}`}>Email me</a>
        <a href={links.github} target="_blank" rel="noopener noreferrer me">GitHub</a>
        <a href={links.linkedin} target="_blank" rel="noopener noreferrer me">LinkedIn</a>
      </div>
    </header>

    <section class="section" aria-labelledby="experience-heading">
      <div class="section-heading">
        <h2 id="experience-heading">Experience</h2>
      </div>
      <div class="resume-list">
        <article class="resume-item">
          <div class="resume-topline">
            <div>
              <h3>Independent Engineering</h3>
              <p>Skaft · Toronto, Canada</p>
            </div>
            <p class="project-meta">2026 to present</p>
          </div>
          <p>
            Building octet, an open-source terminal coding agent in Rust for cloud and local models.
          </p>
          <ul>
            <li>Built an event-driven runtime with typed tool execution, session persistence, approval controls, and a terminal interface.</li>
            <li>Maintained the multi-crate workspace, regression suite, releases, documentation, and compatibility across model APIs.</li>
            <li>Ran local inference experiments on Intel GPU hardware while separating working APIs from verified accelerator execution.</li>
          </ul>
        </article>

        <article class="resume-item">
          <div class="resume-topline">
            <div>
              <h3>Junior Developer</h3>
              <p>Replicant AI · Toronto, Canada</p>
            </div>
            <p class="project-meta">May 2023 to May 2024</p>
          </div>
          <p>
            Worked on conversational AI flows and supporting services used in production customer interactions.
          </p>
          <ul>
            <li>Built TypeScript and Python tools to validate prompts and conversation behavior in CI.</li>
            <li>Refactored Jest integration tests for conversational AI services.</li>
            <li>Developed migration tooling for conversation configuration stored in MongoDB.</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="section" aria-labelledby="education-heading">
      <div class="section-heading">
        <h2 id="education-heading">Education</h2>
      </div>
      <article class="resume-item">
        <div class="resume-topline">
          <div>
            <h3>BASc, Computer Engineering</h3>
            <p>University of Toronto</p>
          </div>
          <p class="project-meta">2021 to 2025</p>
        </div>
      </article>
    </section>

    <section class="section" aria-labelledby="skills-heading">
      <div class="section-heading">
        <h2 id="skills-heading">Technical work</h2>
      </div>
      <div class="detail-grid">
        <div>
          <h3>Languages</h3>
          <p>Rust, TypeScript, JavaScript, Python, Swift, Zig, C, C++, SQL</p>
        </div>
        <div>
          <h3>Systems</h3>
          <p>Agent runtimes, model APIs, terminal interfaces, local inference, audio DSP, test infrastructure</p>
        </div>
        <div>
          <h3>Tools</h3>
          <p>Git, Docker, SQLite, PostgreSQL, MongoDB, React, Next.js, Astro, PyTorch</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
