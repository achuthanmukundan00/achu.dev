---
import BaseLayout from "@layouts/BaseLayout.astro";
import { seo } from "@data/site";
---

<BaseLayout title="Resume" description={seo.resume.description}>
  <div class="shell">
    <header class="page-head">
      <h1>Resume</h1>
    </header>

    <section class="section" aria-labelledby="experience-heading">
      <div class="section-head">
        <h2 id="experience-heading">Experience</h2>
      </div>

      <article class="entry">
        <div class="entry-head">
          <div>
            <h3>Independent Engineering</h3>
            <p class="entry-org">Skaft · Toronto, Canada</p>
          </div>
          <span class="entry-side">2026 – Present</span>
        </div>
        <p class="entry-copy">
          Building octet, an open-source terminal coding agent in Rust for cloud and local
          models.
        </p>
        <ul class="entry-list">
          <li>Built an event-driven runtime with typed tool execution, session persistence, approval controls, and a terminal interface.</li>
          <li>Maintained the multi-crate workspace, regression suite, releases, documentation, and compatibility across model APIs.</li>
          <li>Ran local inference experiments on Intel GPU hardware while separating working APIs from verified accelerator execution.</li>
        </ul>
      </article>

      <article class="entry">
        <div class="entry-head">
          <div>
            <h3>Junior Developer (12-month co-op)</h3>
            <p class="entry-org">Replicant AI · Toronto, Canada</p>
          </div>
          <span class="entry-side">May 2023 – May 2024</span>
        </div>
        <p class="entry-copy">
          Worked on conversational AI flows and supporting services used in production
          customer interactions.
        </p>
        <ul class="entry-list">
          <li>Built TypeScript/Node.js conversation-state handlers for production conversational-AI workflows serving 10K+ daily users.</li>
          <li>Supported backend paths processing 500K+ bot events/day with approximately 150 ms median handler latency.</li>
          <li>Shipped an internal LLM interface adopted by 200+ employees to inspect and test production conversation workflows.</li>
          <li>Modernized data-collection flows with LLM-assisted extraction, improving bot-data accuracy by approximately 30%.</li>
          <li>Implemented caller-timezone detection so after-hours callers received the appropriate redirect or guidance on when to call next, reducing misfires by approximately 15%.</li>
          <li>Added observability that cut issue-triage time by approximately 50%.</li>
        </ul>
      </article>
    </section>

    <section class="section" aria-labelledby="education-heading">
      <div class="section-head">
        <h2 id="education-heading">Education</h2>
      </div>
      <article class="entry">
        <div class="entry-head">
          <div>
            <h3>BASc, Computer Engineering</h3>
            <p class="entry-org">University of Toronto</p>
          </div>
          <span class="entry-side">Graduated 2025</span>
        </div>
      </article>
    </section>

    <section class="section" aria-labelledby="technical-heading">
      <div class="section-head">
        <h2 id="technical-heading">Technical work</h2>
      </div>
      <div class="spec-grid">
        <div class="spec">
          <h3>Languages</h3>
          <p>Rust, TypeScript, JavaScript, Python, Swift, Zig, C, C++, SQL</p>
        </div>
        <div class="spec">
          <h3>Systems</h3>
          <p>Agent runtimes, model APIs, terminal interfaces, local inference, audio DSP, test infrastructure</p>
        </div>
        <div class="spec">
          <h3>Tools</h3>
          <p>Git, Docker, SQLite, PostgreSQL, React, Next.js, Astro, PyTorch</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
