---
import BaseLayout from "@layouts/BaseLayout.astro";
import ProjectCard from "@components/project/ProjectCard.astro";
import { projects } from "@data/projects";
import { seo } from "@data/site";
---

<BaseLayout title="Work" description={seo.work.description}>
  <div class="site-shell">
    <header class="page-header">
      <h1>Work</h1>
      <p class="lead">
        A few projects I've built across developer tools, local AI, audio, and web
        software. Each project includes source and implementation notes.
      </p>
    </header>

    <section class="section" aria-label="Projects">
      <div class="project-list">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  </div>
</BaseLayout>
